/* ---------- Layout ---------- */
:root {
  --sidebar-width: 260px;
  --sidebar-collapsed: 78px;
  --primary: #0a0e27;    /* near-black navy background */
  --accent: #ffffff;
  --hover: #1e3a8a;      /* rich blue hover */
  --brand: #3b82f6;      /* bright blue badge */
  --nav-height: 60px;
}

/* Push content right so sidebar doesn't overlap */
.app-with-sidebar {
  margin-left: var(--sidebar-width);
  transition: margin-left 0.4s ease;
}
.app-with-sidebar.collapsed {
  margin-left: var(--sidebar-collapsed);
}
@media (max-width: 768px) {
  .app-with-sidebar,
  .app-with-sidebar.collapsed { margin-left: 0; }
}

/* ---------- Sidebar ---------- */
.sidebar {
  position: fixed;
  top: 0;
  left: 0;
  height: 100%;
  width: var(--sidebar-width);
  background: var(--primary);
  padding: 6px 14px;
  z-index: 1000;
  transition: width 0.4s ease, left 0.4s ease;
}
.sidebar.collapsed { width: var(--sidebar-collapsed); }

.sidebar .logo-details {
  height: 60px;
  display: flex;
  align-items: center;
  position: relative;
}
.sidebar .logo-details > .bxs-shopping-bag {
  color: var(--accent);
  font-size: 28px;
  min-width: 50px;
  text-align: center;
}
.sidebar .logo-details .logo_name {
  color: var(--accent);
  font-size: 22px;
  font-weight: 600;
  white-space: nowrap;
  opacity: 1;
  transition: 0.3s ease;
}
.sidebar.collapsed .logo_name { opacity: 0; pointer-events: none; }

.sidebar #btn-toggle {
  position: absolute;
  left: 90%;
  top: 6px;
  transform: translateX(-50%);
  color: var(--accent);
  font-size: 20px;
  cursor: pointer;
  height: 40px;
  width: 40px;
  line-height: 40px;
  text-align: center;
  border-radius: 12px;
  transition: 0.3s;
}
.sidebar #btn-toggle:hover { background: var(--hover); }
.sidebar.collapsed #btn-toggle { left: 50%; }

.sidebar ul { margin-top: 10px; list-style: none; padding-left: 0; }
.sidebar ul li {
  position: relative;
  margin: 6px 0;
  border-radius: 12px;
  transition: 0.3s;
  list-style: none;
}
.sidebar ul li:hover { background: var(--hover); }

.sidebar ul li a {
  display: flex;
  align-items: center;
  text-decoration: none;
  color: var(--accent);
  padding: 10px;
  border-radius: 12px;
  white-space: nowrap;
}
.sidebar ul li a.active { background: var(--hover); }
.sidebar ul li a i { min-width: 40px; font-size: 20px; text-align: center; }
.sidebar ul li a .link_name {
  opacity: 1;
  transition: 0.3s;
  font-size: 15px;
}
.sidebar.collapsed ul li a .link_name { opacity: 0; pointer-events: none; }

/* Tooltip when collapsed */
.sidebar.collapsed ul li .tooltip {
  position: absolute;
  left: 100%;
  top: 50%;
  transform: translateY(-50%);
  background: var(--accent);
  color: var(--primary);
  padding: 6px 12px;
  border-radius: 8px;
  font-size: 13px;
  opacity: 0;
  pointer-events: none;
  transition: 0.2s;
  white-space: nowrap;
  margin-left: 12px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.2);
}
.sidebar.collapsed ul li:hover .tooltip { opacity: 1; }
.sidebar:not(.collapsed) ul li .tooltip { display: none; }

.sidebar .badge {
  background: var(--brand);
  color: #fff;
  font-size: 11px;
  padding: 2px 7px;
  border-radius: 10px;
  margin-left: auto;
}
.sidebar.collapsed .badge { display: none; }

.sidebar .profile-details {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  display: flex;
  align-items: center;
  background: var(--hover);
  padding: 12px 14px;
  transition: 0.3s;
}
.sidebar.collapsed .profile-details { background: none; justify-content: center; }
.sidebar .profile-details img { height: 42px; width: 42px; border-radius: 12px; object-fit: cover; }
.sidebar .profile-details .profile_name,
.sidebar .profile-details .job {
  color: var(--accent);
  font-size: 14px;
  white-space: nowrap;
  margin-left: 12px;
  transition: 0.3s;
}
.sidebar .profile-details .job { font-size: 12px; opacity: 0.7; }
.sidebar.collapsed .profile_info { display: none; }

/* Mobile hamburger */
.sidebar-mobile-toggle {
  display: none;
  position: fixed;
  top: 12px;
  left: 12px;
  z-index: 1001;
  background: var(--primary);
  color: #fff;
  border: none;
  font-size: 24px;
  width: 44px;
  height: 44px;
  border-radius: 10px;
  cursor: pointer;
  align-items: center;
  justify-content: center;
}

.sidebar-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: none;
}

/* ---------- Responsive ---------- */
@media (max-width: 768px) {
  .sidebar {
    left: -260px;
    width: var(--sidebar-width);
  }
  .sidebar.active { left: 0; }
  .sidebar.collapsed { width: var(--sidebar-width); }
  .sidebar.collapsed ul li a .link_name { opacity: 1; }
  .sidebar.collapsed .logo_name { opacity: 1; }
  .sidebar.collapsed .profile_info { display: block; }
  .sidebar.collapsed #btn-toggle { left: 90%; }
  .sidebar #btn-toggle { display: none; }

  .sidebar-mobile-toggle { display: flex; }
  .sidebar-backdrop { display: block; }
}

/* ---------- Submenu (Settings) ---------- */
.sidebar .has-submenu > a {
  display: flex;
  align-items: center;
  color: var(--accent);
  text-decoration: none;
  padding: 10px;
  border-radius: 12px;
  white-space: nowrap;
  cursor: pointer;
}
.sidebar .has-submenu > a .submenu-arrow {
  margin-left: auto;
  min-width: auto;
  font-size: 18px;
  transition: transform 0.3s ease;
}
.sidebar .has-submenu > a .submenu-arrow.rotate {
  transform: rotate(180deg);
}

/* Submenu list */
.sidebar .has-submenu .submenu {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s ease, padding 0.3s ease;
  list-style: none;
  padding-left: 0;
  margin: 0;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 10px;
}
.sidebar .has-submenu .submenu.open {
  max-height: 300px;
  padding: 4px 0;
  margin: 4px 0 6px 0;
}

.sidebar .has-submenu .submenu li {
  margin: 2px 0;
  border-radius: 8px;
}
.sidebar .has-submenu .submenu li:hover {
  background: var(--hover);
}

.sidebar .has-submenu .submenu li a {
  display: flex;
  align-items: center;
  padding: 8px 10px 8px 24px;
  color: var(--accent);
  text-decoration: none;
  border-radius: 8px;
  font-size: 14px;
  white-space: nowrap;
}
.sidebar .has-submenu .submenu li a i {
  font-size: 16px;
  min-width: 32px;
}
.sidebar .has-submenu .submenu li a.active {
  background: var(--hover);
}

/* When sidebar is collapsed, hide submenu entirely */
.sidebar.collapsed .has-submenu .submenu {
  display: none;
}
.sidebar.collapsed .has-submenu > a .submenu-arrow {
  display: none;
}
.sidebar.collapsed .has-submenu > a .link_name {
  display: none;
}

/* ---------- Notification dot on Orders ---------- */
.sidebar .badge-dot {
  width: 8px;
  height: 8px;
  min-width: 8px;
  padding: 0;
  border-radius: 50%;
  background: #ef4444;
  margin-left: auto;
  animation: pulse-dot 2s infinite;
}
@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%      { opacity: 0.6; transform: scale(1.2); }
}
.sidebar.collapsed .badge-dot {
  display: block;
  position: absolute;
  top: 8px;
  right: 14px;
  width: 8px;
  height: 8px;
}

/* ============================================================
   ACTIVE MENU ITEM — Advanced Curved Indicator
   ============================================================ */

/* The active link itself — floating rounded pill */
.sidebar ul.nav-list > li > a.active {
  background: linear-gradient(90deg, #2563eb 0%, #3b82f6 100%);
  color: #fff;
  border-radius: 16px;
  position: relative;
  box-shadow:
    0 4px 12px -4px rgba(59, 130, 246, 0.45),
    0 0 0 1px rgba(59, 130, 246, 0.2);
  z-index: 2;
}

/* Slight glow on hover for non-active items */
.sidebar ul.nav-list > li:not(:has(> a.active)) > a:hover {
  background: rgba(59, 130, 246, 0.08);
  border-radius: 16px;
}

/* The wrapper li must be positioned */
.sidebar ul.nav-list > li:has(> a.active) {
  position: relative;
  margin: 6px 0;
}

/* ---------- TOP curve notch ---------- */
.sidebar ul.nav-list > li:has(> a.active)::before {
  content: '';
  position: absolute;
  right: -10px;               /* sits flush against sidebar edge */
  top: -10px;                 /* rises above the item */
  width: 20px;
  height: 20px;
  background: transparent;
  border-bottom-right-radius: 20px;
  box-shadow: 6px 6px 0 0 #3b82f6;
  z-index: 1;
  pointer-events: none;
}

/* ---------- BOTTOM curve notch ---------- */
.sidebar ul.nav-list > li:has(> a.active)::after {
  content: '';
  position: absolute;
  right: -10px;
  bottom: -10px;              /* drops below the item */
  width: 20px;
  height: 20px;
  background: transparent;
  border-top-right-radius: 20px;
  box-shadow: 6px -6px 0 0 #3b82f6;
  z-index: 1;
  pointer-events: none;
}

/* ---------- Small white "inner glow" dots at the curve roots ---------- */
.sidebar ul.nav-list > li > a.active::before,
.sidebar ul.nav-list > li > a.active::after {
  content: '';
  position: absolute;
  right: -10px;
  width: 3px;
  height: 3px;
  background: transparent;
  border-radius: 50%;
  box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.35);
  pointer-events: none;
}
.sidebar ul.nav-list > li > a.active::before { top: 2px; }
.sidebar ul.nav-list > li > a.active::after  { bottom: 2px; }

/* ---------- Hide all indicator decorations when sidebar is collapsed ---------- */
.sidebar.collapsed ul.nav-list > li:has(> a.active)::before,
.sidebar.collapsed ul.nav-list > li:has(> a.active)::after,
.sidebar.collapsed ul.nav-list > li > a.active::before,
.sidebar.collapsed ul.nav-list > li > a.active::after {
  display: none;
}

/* In collapsed mode, just a soft blue circle around the icon */
.sidebar.collapsed ul.nav-list > li > a.active {
  background: linear-gradient(90deg, #2563eb 0%, #3b82f6 100%);
  border-radius: 14px;
  margin: 4px 6px;
}

