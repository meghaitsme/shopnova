/* ============================================================
   ShopFree Sidebar — Complete Stylesheet (FIXED active pill)
   ============================================================ */

:root {
  --sidebar-width: 260px;
  --sidebar-collapsed: 78px;
  --primary: #0a0e27;
  --accent: #ffffff;
  --hover: #1e3a8a;
  --brand: #3b82f6;
  --brand-dark: #2563eb;
  --danger: #ef4444;
  --bar-width: 5px;
}

/* ---------- Content push ---------- */
.app-with-sidebar {
  margin-left: var(--sidebar-width);
  transition: margin-left 0.4s ease;
}
.app-with-sidebar.collapsed {
  margin-left: var(--sidebar-collapsed);
}

/* ============================================================
   SIDEBAR SHELL
   ============================================================ */
.sidebar {
  position: fixed;
  top: 0;
  left: 0;
  height: 100vh;
  width: var(--sidebar-width);
  background: var(--primary);
  padding: 6px 14px;
  z-index: 1000;
  transition: width 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: visible;
}
.sidebar.collapsed {
  width: var(--sidebar-collapsed);
}

/* ============================================================
   FULL-HEIGHT BLUE BAR — rendered as the sidebar's right border
   This must be BELOW the nav list so notches can carve into it
   ============================================================ */
.sidebar::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  right: 0;
  width: var(--bar-width);
  background: linear-gradient(180deg, var(--brand) 0%, var(--brand-dark) 100%);
  box-shadow: 0 0 14px rgba(59, 130, 246, 0.45);
  pointer-events: none;
  z-index: 1;
}

/* ============================================================
   LOGO
   ============================================================ */
.sidebar .logo-details {
  height: 60px;
  display: flex;
  align-items: center;
  position: relative;
  z-index: 5;
}
.sidebar .logo-details > .bxs-shopping-bag {
  color: var(--accent);
  font-size: 28px;
  min-width: 50px;
  text-align: center;
}
.sidebar .logo-details .logo_name {
  color: var(--accent);
  font-size: 22px;
  font-weight: 600;
  white-space: nowrap;
  transition: opacity 0.25s ease;
}
.sidebar.collapsed .logo_name {
  opacity: 0;
  pointer-events: none;
}

.sidebar #btn-toggle {
  position: absolute;
  left: 90%;
  top: 6px;
  transform: translateX(-50%);
  color: var(--accent);
  font-size: 20px;
  cursor: pointer;
  height: 40px;
  width: 40px;
  line-height: 40px;
  text-align: center;
  border-radius: 12px;
  transition: 0.25s;
  z-index: 5;
}
.sidebar #btn-toggle:hover {
  background: var(--hover);
}
.sidebar.collapsed #btn-toggle {
  left: 50%;
}

/* ============================================================
   NAV LIST — sits above the blue bar
   ============================================================ */
.sidebar ul.nav-list {
  margin-top: 10px;
  list-style: none;
  padding-left: 0;
  position: relative;
  z-index: 2;
}

.sidebar ul.nav-list > li {
  position: relative;
  margin: 4px 0;
  border-radius: 12px;
  transition: background 0.2s ease;
}

.sidebar ul.nav-list > li:not(:has(> a.active)) > a:hover {
  background: rgba(59, 130, 246, 0.1);
  border-radius: 12px;
}

.sidebar ul.nav-list > li > a {
  display: flex;
  align-items: center;
  text-decoration: none;
  color: var(--accent);
  padding: 10px;
  border-radius: 12px;
  white-space: nowrap;
  cursor: pointer;
  transition: color 0.2s ease, background 0.2s ease;
}
.sidebar ul.nav-list > li > a i {
  min-width: 40px;
  font-size: 20px;
  text-align: center;
}
.sidebar ul.nav-list > li > a .link_name {
  transition: opacity 0.25s ease;
  font-size: 15px;
}
.sidebar.collapsed ul.nav-list > li > a .link_name {
  opacity: 0;
  pointer-events: none;
  width: 0;
}

/* ============================================================
   ACTIVE ITEM — PILL (expanded mode)
   The active pill extends to the right edge to blend with the bar.
   ============================================================ */
.sidebar:not(.collapsed) ul.nav-list > li > a.active {
  background: linear-gradient(90deg, var(--brand-dark) 0%, var(--brand) 100%);
  color: #fff;
  border-top-right-radius: 20px;
  border-bottom-right-radius: 20px;
  border-top-left-radius: 14px;
  border-bottom-left-radius: 14px;
  /* Extend the pill right up to the bar */
  margin-right: -4px;
  padding-right: 24px;
  box-shadow:
    0 4px 14px -4px rgba(59, 130, 246, 0.5),
    inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  z-index: 3;
  position: relative;
}

/* Notch — TOP (expanded mode) */
.sidebar:not(.collapsed) ul.nav-list > li:has(> a.active)::before {
  content: '';
  position: absolute;
  right: -4px;
  top: -6px;
  width: 16px;
  height: 16px;
  background: transparent;
  border-bottom-right-radius: 16px;
  box-shadow: 4px 4px 0 0 var(--brand);
  z-index: 2;
  pointer-events: none;
}

/* Notch — BOTTOM (expanded mode) */
.sidebar:not(.collapsed) ul.nav-list > li:has(> a.active)::after {
  content: '';
  position: absolute;
  right: -4px;
  bottom: -6px;
  width: 16px;
  height: 16px;
  background: transparent;
  border-top-right-radius: 16px;
  box-shadow: 4px -4px 0 0 var(--brand);
  z-index: 2;
  pointer-events: none;
}

/* ============================================================
   ACTIVE ITEM — COLLAPSED MODE (this is the reference design)
   The active pill is a rounded square that touches the bar.
   ============================================================ */
.sidebar.collapsed ul.nav-list > li > a.active {
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
  color: #fff;
  border-radius: 14px;
  margin: 4px 0;
  padding: 10px;
  box-shadow:
    0 6px 16px -4px rgba(59, 130, 246, 0.65),
    inset 0 0 0 1px rgba(255, 255, 255, 0.12);
  z-index: 3;
  position: relative;
}
.sidebar.collapsed ul.nav-list > li > a.active i {
  color: #ffffff;
}

/* Notch — TOP (collapsed mode) */
.sidebar.collapsed ul.nav-list > li:has(> a.active)::before {
  content: '';
  position: absolute;
  right: -4px;
  top: -2px;
  width: 14px;
  height: 14px;
  background: transparent;
  border-bottom-right-radius: 14px;
  box-shadow: 4px 4px 0 0 var(--brand);
  z-index: 2;
  pointer-events: none;
}

/* Notch — BOTTOM (collapsed mode) */
.sidebar.collapsed ul.nav-list > li:has(> a.active)::after {
  content: '';
  position: absolute;
  right: -4px;
  bottom: -2px;
  width: 14px;
  height: 14px;
  background: transparent;
  border-top-right-radius: 14px;
  box-shadow: 4px -4px 0 0 var(--brand);
  z-index: 2;
  pointer-events: none;
}

/* ============================================================
   BADGES
   ============================================================ */
.sidebar .badge {
  background: var(--brand);
  color: #fff;
  font-size: 11px;
  font-weight: 600;
  padding: 2px 7px;
  border-radius: 10px;
  margin-left: auto;
  min-width: 18px;
  text-align: center;
}
.sidebar.collapsed .badge {
  display: none;
}

.sidebar .badge-dot {
  width: 8px;
  height: 8px;
  min-width: 8px;
  padding: 0;
  border-radius: 50%;
  background: var(--danger);
  margin-left: auto;
  animation: pulse-dot 2s infinite;
}
@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%      { opacity: 0.6; transform: scale(1.25); }
}
.sidebar.collapsed .badge-dot {
  display: block;
  position: absolute;
  top: 8px;
  right: 12px;
}

/* ============================================================
   TOOLTIPS
   ============================================================ */
.sidebar.collapsed ul.nav-list > li .tooltip {
  position: absolute;
  left: 100%;
  top: 50%;
  transform: translateY(-50%);
  background: var(--accent);
  color: var(--primary);
  padding: 6px 12px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 500;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
  white-space: nowrap;
  margin-left: 14px;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
  z-index: 10;
}
.sidebar.collapsed ul.nav-list > li:hover .tooltip {
  opacity: 1;
}
.sidebar:not(.collapsed) ul.nav-list > li .tooltip {
  display: none;
}

/* ============================================================
   DIVIDER
   ============================================================ */
.sidebar ul.nav-list .nav-divider {
  height: 1px;
  background: rgba(255, 255, 255, 0.08);
  margin: 12px 8px;
  padding: 0;
  pointer-events: none;
}
.sidebar.collapsed ul.nav-list .nav-divider {
  margin: 12px 4px;
}

/* ============================================================
   SUBMENU
   ============================================================ */
.sidebar .has-submenu > a {
  display: flex;
  align-items: center;
  color: var(--accent);
  text-decoration: none;
  padding: 10px;
  border-radius: 12px;
  white-space: nowrap;
  cursor: pointer;
}
.sidebar .has-submenu > a .submenu-arrow {
  margin-left: auto;
  min-width: auto;
  font-size: 18px;
  transition: transform 0.3s ease;
}
.sidebar .has-submenu > a .submenu-arrow.rotate {
  transform: rotate(180deg);
}
.sidebar .has-submenu .submenu {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s ease;
  list-style: none;
  padding-left: 0;
  margin: 0;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 10px;
}
.sidebar .has-submenu .submenu.open {
  max-height: 300px;
  padding: 4px 0;
  margin: 4px 0 6px 0;
}
.sidebar .has-submenu .submenu li {
  margin: 2px 0;
  border-radius: 8px;
}
.sidebar .has-submenu .submenu li:hover {
  background: var(--hover);
}
.sidebar .has-submenu .submenu li a {
  display: flex;
  align-items: center;
  padding: 8px 10px 8px 24px;
  color: var(--accent);
  text-decoration: none;
  border-radius: 8px;
  font-size: 14px;
  white-space: nowrap;
}
.sidebar .has-submenu .submenu li a i {
  font-size: 16px;
  min-width: 32px;
}
.sidebar .has-submenu .submenu li a.active {
  background: var(--hover);
}
.sidebar.collapsed .has-submenu .submenu { display: none; }
.sidebar.collapsed .has-submenu > a .submenu-arrow { display: none; }
.sidebar.collapsed .has-submenu > a .link_name { display: none; }

/* ============================================================
   PROFILE
   ============================================================ */
.sidebar .profile-details {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  display: flex;
  align-items: center;
  background: linear-gradient(90deg, #1e3a8a 0%, #1e40af 100%);
  padding: 12px 14px;
  transition: 0.3s;
}
.sidebar.collapsed .profile-details {
  background: none;
  justify-content: center;
}
.sidebar .profile-details img {
  height: 42px;
  width: 42px;
  border-radius: 12px;
  object-fit: cover;
}
.sidebar .profile-details .profile_name,
.sidebar .profile-details .job {
  color: var(--accent);
  font-size: 14px;
  white-space: nowrap;
  margin-left: 12px;
  transition: 0.3s;
}
.sidebar .profile-details .job {
  font-size: 12px;
  opacity: 0.75;
}
.sidebar.collapsed .profile_info {
  display: none;
}

/* ============================================================
   MOBILE
   ============================================================ */
.sidebar-mobile-toggle {
  display: none;
  position: fixed;
  top: 12px;
  left: 12px;
  z-index: 1001;
  background: var(--primary);
  color: #fff;
  border: none;
  font-size: 24px;
  width: 44px;
  height: 44px;
  border-radius: 10px;
  cursor: pointer;
  align-items: center;
  justify-content: center;
}
.sidebar-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 999;
  display: none;
}

@media (max-width: 768px) {
  .app-with-sidebar,
  .app-with-sidebar.collapsed {
    margin-left: 0;
  }
  .sidebar {
    left: -100%;
    width: var(--sidebar-width);
    transition: left 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .sidebar.active { left: 0; }
  .sidebar.collapsed { width: var(--sidebar-width); }
  .sidebar.collapsed ul.nav-list > li > a .link_name {
    opacity: 1;
    width: auto;
  }
  .sidebar.collapsed .logo_name { opacity: 1; }
  .sidebar.collapsed .profile_info { display: block; }
  .sidebar.collapsed #btn-toggle { left: 90%; }
  .sidebar #btn-toggle { display: none; }
  .sidebar-mobile-toggle { display: flex; }
  .sidebar-backdrop { display: block; }
}

